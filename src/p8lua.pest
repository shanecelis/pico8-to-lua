// Pico-8 Lua. Newlines are whitespace, so ordinary multiline Lua parses.
// Shorthand if/while is compound-atomic: only spaces and tabs, so the body
// stops at the end of the line. `if expr then` is tried first.

WHITESPACE = _{ " " | "\t" | "\r\n" | "\n" | "\r" }
COMMENT = _{
    "//" ~ (!("\r" | "\n") ~ ANY)* ~ ("\r\n" | "\n" | "\r")?
  | "--" ~ long_brackets
  | "--" ~ (!("\r" | "\n") ~ ANY)* ~ ("\r\n" | "\n" | "\r")?
}

hws = _{ " " | "\t" }
// P8SCII 0x1e, 0x1f, and 0x80-0xff. Pico-8 accepts these in identifiers.
// Codes 16-29 and 127 are punctuation; they only occur inside strings.
p8_char = _{
    "\u{309B}" | "\u{309C}"
  | "\u{2588}" | "\u{2592}" | "\u{1F431}" | "\u{2B07}" | "\u{2591}" | "\u{273D}"
  | "\u{25CF}" | "\u{2665}" | "\u{2609}" | "\u{C6C3}" | "\u{2302}" | "\u{2B05}"
  | "\u{1F610}" | "\u{266A}" | "\u{1F17E}" | "\u{25C6}" | "\u{2026}" | "\u{27A1}"
  | "\u{2605}" | "\u{29D7}" | "\u{2B06}" | "\u{02C7}" | "\u{2227}" | "\u{274E}"
  | "\u{25A4}" | "\u{25A5}"
  | "\u{3042}" | "\u{3044}" | "\u{3046}" | "\u{3048}" | "\u{304A}"
  | "\u{304B}" | "\u{304D}" | "\u{304F}" | "\u{3051}" | "\u{3053}"
  | "\u{3055}" | "\u{3057}" | "\u{3059}" | "\u{305B}" | "\u{305D}"
  | "\u{305F}" | "\u{3061}" | "\u{3064}" | "\u{3066}" | "\u{3068}"
  | "\u{306A}" | "\u{306B}" | "\u{306C}" | "\u{306D}" | "\u{306E}"
  | "\u{306F}" | "\u{3072}" | "\u{3075}" | "\u{3078}" | "\u{307B}"
  | "\u{307E}" | "\u{307F}" | "\u{3080}" | "\u{3081}" | "\u{3082}"
  | "\u{3084}" | "\u{3086}" | "\u{3088}"
  | "\u{3089}" | "\u{308A}" | "\u{308B}" | "\u{308C}" | "\u{308D}"
  | "\u{308F}" | "\u{3092}" | "\u{3093}"
  | "\u{3063}" | "\u{3083}" | "\u{3085}" | "\u{3087}"
  | "\u{30A2}" | "\u{30A4}" | "\u{30A6}" | "\u{30A8}" | "\u{30AA}"
  | "\u{30AB}" | "\u{30AD}" | "\u{30AF}" | "\u{30B1}" | "\u{30B3}"
  | "\u{30B5}" | "\u{30B7}" | "\u{30B9}" | "\u{30BB}" | "\u{30BD}"
  | "\u{30BF}" | "\u{30C1}" | "\u{30C4}" | "\u{30C6}" | "\u{30C8}"
  | "\u{30CA}" | "\u{30CB}" | "\u{30CC}" | "\u{30CD}" | "\u{30CE}"
  | "\u{30CF}" | "\u{30D2}" | "\u{30D5}" | "\u{30D8}" | "\u{30DB}"
  | "\u{30DE}" | "\u{30DF}" | "\u{30E0}" | "\u{30E1}" | "\u{30E2}"
  | "\u{30E4}" | "\u{30E6}" | "\u{30E8}"
  | "\u{30E9}" | "\u{30EA}" | "\u{30EB}" | "\u{30EC}" | "\u{30ED}"
  | "\u{30EF}" | "\u{30F2}" | "\u{30F3}"
  | "\u{30C3}" | "\u{30E3}" | "\u{30E5}" | "\u{30E7}"
  | "\u{25DC}" | "\u{25DD}"
}
ident_cont = _{ ASCII_ALPHANUMERIC | "_" | p8_char | "\u{FE0F}" }

k_and = @{ "and" ~ !ident_cont }
k_break = @{ "break" ~ !ident_cont }
k_do = @{ "do" ~ !ident_cont }
k_else = @{ "else" ~ !ident_cont }
k_elseif = @{ "elseif" ~ !ident_cont }
k_end = @{ "end" ~ !ident_cont }
k_false = @{ "false" ~ !ident_cont }
k_for = @{ "for" ~ !ident_cont }
k_function = @{ "function" ~ !ident_cont }
k_goto = @{ "goto" ~ !ident_cont }
k_if = @{ "if" ~ !ident_cont }
k_in = @{ "in" ~ !ident_cont }
k_local = @{ "local" ~ !ident_cont }
k_nil = @{ "nil" ~ !ident_cont }
k_not = @{ "not" ~ !ident_cont }
k_or = @{ "or" ~ !ident_cont }
k_repeat = @{ "repeat" ~ !ident_cont }
k_return = @{ "return" ~ !ident_cont }
k_then = @{ "then" ~ !ident_cont }
k_true = @{ "true" ~ !ident_cont }
k_until = @{ "until" ~ !ident_cont }
k_while = @{ "while" ~ !ident_cont }

// One atomic rule, not a call per keyword. `!keyword` runs on every name.
keyword = @{
    ("elseif" | "function" | "repeat" | "return" | "until" | "while" | "break"
    | "false" | "local" | "then" | "true" | "and" | "end" | "for" | "goto"
    | "nil" | "not" | "else" | "do" | "if" | "in" | "or") ~ !ident_cont
}

name = @{ !keyword ~ (ASCII_ALPHA | "_" | p8_char) ~ ident_cont* }

chunk = { SOI ~ block ~ EOI }
block = _{ stmt* }

stmt = _{
    ";"
  | include
  | if_stmt
  | shorthand_if
  | while_stmt
  | shorthand_while
  | repeat_stmt
  | for_num
  | for_in
  | function_stmt
  | local_function
  | local_stmt
  | do_stmt
  | goto_stmt
  | k_break
  | label
  | return_stmt
  | assign
  | compound_assign
  | functioncall
  | print_stmt
}

include = @{ "#" ~ hws* ~ "include" ~ (!("\r" | "\n") ~ ANY)* }

if_stmt = _{
    k_if ~ hws* ~ expr ~ hws* ~ k_then ~ hws* ~ block
    ~ (hws* ~ k_elseif ~ hws* ~ expr ~ hws* ~ k_then ~ hws* ~ block)*
    ~ (hws* ~ k_else ~ hws* ~ block)?
    ~ hws* ~ k_end
}

// `$` keeps child pairs and suppresses implicit whitespace, including newlines.
shorthand_if = ${
    k_if ~ hws* ~ "(" ~ hws* ~ expr ~ hws* ~ ")" ~ hws* ~ shorthand_body
    ~ (hws* ~ k_else ~ hws* ~ shorthand_body)?
}
shorthand_while = ${
    k_while ~ hws* ~ "(" ~ hws* ~ expr ~ hws* ~ ")" ~ hws* ~ shorthand_body
}
shorthand_body = { stmt ~ (hws* ~ stmt)* }

while_stmt = _{ k_while ~ hws* ~ expr ~ hws* ~ k_do ~ hws* ~ block ~ hws* ~ k_end }
repeat_stmt = _{ k_repeat ~ hws* ~ block ~ hws* ~ k_until ~ hws* ~ expr }
for_num = _{
    k_for ~ hws* ~ name ~ hws* ~ "=" ~ !"=" ~ hws* ~ expr ~ hws* ~ "," ~ hws* ~ expr
    ~ (hws* ~ "," ~ hws* ~ expr)? ~ hws* ~ k_do ~ hws* ~ block ~ hws* ~ k_end
}
for_in = _{
    k_for ~ hws* ~ namelist ~ hws* ~ k_in ~ hws* ~ explist ~ hws* ~ k_do ~ hws* ~ block ~ hws* ~ k_end
}
function_stmt = _{ k_function ~ hws* ~ funcname ~ hws* ~ funcbody }
local_function = _{ k_local ~ hws* ~ k_function ~ hws* ~ name ~ hws* ~ funcbody }
local_stmt = _{ k_local ~ hws* ~ namelist ~ (hws* ~ "=" ~ !"=" ~ hws* ~ explist)? }
do_stmt = _{ k_do ~ hws* ~ block ~ hws* ~ k_end }
goto_stmt = _{ k_goto ~ hws* ~ name }
label = _{ "::" ~ hws* ~ name ~ hws* ~ "::" }
return_stmt = _{ k_return ~ (hws* ~ explist)? ~ (hws* ~ ";")? }

compound_assign = { var ~ hws* ~ compound_op ~ hws* ~ expr }
assign = _{ varlist ~ hws* ~ "=" ~ !"=" ~ hws* ~ explist }
print_stmt = { "?" ~ hws* ~ explist }

varlist = _{ var ~ (hws* ~ "," ~ hws* ~ var)* }
namelist = _{ name ~ (hws* ~ "," ~ hws* ~ name)* }
explist = _{ expr ~ (hws* ~ "," ~ hws* ~ expr)* }

funcname = _{ name ~ (hws* ~ "." ~ hws* ~ name)* ~ (hws* ~ ":" ~ hws* ~ name)? }
funcbody = _{ "(" ~ hws* ~ parlist? ~ hws* ~ ")" ~ hws* ~ block ~ hws* ~ k_end }
parlist = _{ namelist ~ (hws* ~ "," ~ hws* ~ "...")? | "..." }
function_expr = _{ k_function ~ hws* ~ funcbody }

// Lowest precedence first. `..` and `^` are right-associative.
expr = { or_expr }
or_expr = _{ and_expr ~ (hws* ~ k_or ~ hws* ~ and_expr)* }
and_expr = _{ cmp_expr ~ (hws* ~ k_and ~ hws* ~ cmp_expr)* }
cmp_expr = _{ bitor_expr ~ (hws* ~ cmp_op ~ hws* ~ bitor_expr)* }
cmp_op = @{ "==" | "~=" | "!=" | "<=" | ">=" | "<" | ">" }
bitor_expr = _{ bitxor_expr ~ (hws* ~ "|" ~ hws* ~ bitxor_expr)* }
bitxor_expr = _{ bitand_expr ~ (hws* ~ "^^" ~ hws* ~ bitand_expr)* }
bitand_expr = _{ shift_expr ~ (hws* ~ "&" ~ hws* ~ shift_expr)* }
shift_expr = _{ concat_expr ~ (hws* ~ shift_op ~ hws* ~ concat_expr)* }
shift_op = @{ "<<>" | ">><" | ">>>" | "<<" | ">>" }
concat_expr = _{ add_expr ~ (hws* ~ ".." ~ !"." ~ hws* ~ concat_expr)? }
add_expr = _{ mul_expr ~ (hws* ~ add_op ~ hws* ~ mul_expr)* }
add_op = @{ "+" ~ !"=" | "-" ~ !"=" }
mul_expr = _{ unary ~ (hws* ~ mul_op ~ hws* ~ unary)* }
mul_op = @{ "*" ~ !"=" | "/" ~ !"/" ~ !"=" | "%" ~ !"=" | "\\" ~ !"=" }
unary = _{ (unary_op ~ hws* ~ unary) | pow_expr }
unary_op = @{ k_not | "#" | "-" ~ !"=" | "~" ~ !"=" }
pow_expr = _{ primary ~ (hws* ~ "^" ~ !"=" ~ hws* ~ unary)? }

// A lone Shift-glyph is a number, so it is tried before names. `♥.x` still
// parses as a name because the glyph rule stops at `.`, `:`, `(`, or more name.
primary = _{
    button
  | prefix_exp
  | number
  | string
  | k_nil | k_false | k_true
  | "..."
  | function_expr
  | table
}

// One pass over a name or `(expr)`, then any `.` / `[]` / call suffixes.
// Trying `functioncall | var` reparsed every field (`self.x`) and every `(expr)`.
prefix_exp = _{
    simple_prefix
    ~ (hws* ~ (dot_suffix_bare | call_suffix))*
}

var = { name ~ dot_suffix* | ("(" ~ hws* ~ expr ~ hws* ~ ")") ~ dot_suffix+ }
dot_suffix = _{ hws* ~ ("." ~ hws* ~ name | "[" ~ hws* ~ expr ~ hws* ~ "]") }

// A repeat does not backtrack, so dots are consumed first and the required
// call stays put. Otherwise `obj:step()` and `(e):map()` lose their call.
functioncall = _{
    simple_prefix
    ~ (hws* ~ dot_suffix_bare)*
    ~ hws* ~ call_suffix
    ~ (hws* ~ (dot_suffix_bare | call_suffix))*
}
simple_prefix = _{ name | ("(" ~ hws* ~ expr ~ hws* ~ ")") }
dot_suffix_bare = _{ "." ~ hws* ~ name | "[" ~ hws* ~ expr ~ hws* ~ "]" }
call_suffix = _{ (":" ~ hws* ~ name ~ hws*)? ~ args }
args = _{
    "(" ~ hws* ~ explist? ~ hws* ~ ")"
  | table
  | string
}

table = _{ "{" ~ hws* ~ fieldlist? ~ hws* ~ "}" }
fieldlist = _{ field ~ (hws* ~ fieldsep ~ hws* ~ field)* ~ (hws* ~ fieldsep)? ~ hws* }
field = _{
    "[" ~ hws* ~ expr ~ hws* ~ "]" ~ hws* ~ "=" ~ !"=" ~ hws* ~ expr
  | name ~ hws* ~ "=" ~ !"=" ~ hws* ~ expr
  | expr
}
fieldsep = _{ "," | ";" }

compound_op = @{
    "<<>=" | ">><=" | ">>>=" | "^^=" | "..="
  | "<<=" | ">>="
  | "+=" | "-=" | "*=" | "/=" | "%=" | "^=" | "|=" | "&=" | "\\="
}

number = { binary | hex_float | hex | float | int }
binary = @{
    "0" ~ ("b" | "B") ~ ("0" | "1")+ ~ ("." ~ ("0" | "1")*)?
  | "0" ~ ("b" | "B") ~ "." ~ ("0" | "1")+
}
hex_float = @{
    "0" ~ ("x" | "X") ~ ASCII_HEX_DIGIT+ ~ "." ~ ASCII_HEX_DIGIT* ~ hex_exp?
  | "0" ~ ("x" | "X") ~ "." ~ ASCII_HEX_DIGIT+ ~ hex_exp?
  | "0" ~ ("x" | "X") ~ ASCII_HEX_DIGIT+ ~ hex_exp
}
hex_exp = _{ ("p" | "P") ~ ("+" | "-")? ~ ASCII_DIGIT+ }
hex = @{ "0" ~ ("x" | "X") ~ ASCII_HEX_DIGIT+ }
float = @{
    ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT* ~ exp_part?
  | "." ~ ASCII_DIGIT+ ~ exp_part?
  | ASCII_DIGIT+ ~ exp_part
}
exp_part = _{ ("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+ }
int = @{ ASCII_DIGIT+ }

string = @{ short_string | long_brackets }
short_string = @{
    "\"" ~ (escape | !"\"" ~ !("\r" | "\n") ~ ANY)* ~ "\""
  | "'" ~ (escape | !"'" ~ !("\r" | "\n") ~ ANY)* ~ "'"
}
escape = @{ "\\" ~ ANY }
long_brackets = @{
    "[" ~ PUSH("="*) ~ "[" ~ (!("]" ~ PEEK ~ "]") ~ ANY)* ~ "]" ~ POP ~ "]"
}

// Shift+A..Z. Six are button indexes; the other twenty are fillp() patterns.
// Optional U+FE0F is how Pico-8 writes the arrow and O keys into a .p8 file.
// Same-line spaces only: a newline starts the next statement, not a longer name.
button = @{ glyph_chars ~ !glyph_follower }
glyph_chars = _{
    ("\u{2B05}" | "\u{27A1}" | "\u{2B06}" | "\u{2B07}" | "\u{1F17E}" | "\u{274E}") ~ "\u{FE0F}"?
  | "\u{2588}" | "\u{2592}" | "\u{1F431}" | "\u{2591}" | "\u{273D}" | "\u{25CF}"
  | "\u{2665}" | "\u{2609}" | "\u{C6C3}" | "\u{2302}" | "\u{1F610}" | "\u{266A}"
  | "\u{25C6}" | "\u{2026}" | "\u{2605}" | "\u{29D7}" | "\u{02C7}" | "\u{2227}"
  | "\u{25A4}" | "\u{25A5}"
}
glyph_follower = _{ hws* ~ (ident_cont | "." | ":" | "(") }
